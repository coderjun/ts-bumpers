{
  "name": "ts-agent-starter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "prepare": "if [ -d .git ] && command -v lefthook >/dev/null; then lefthook install; else echo 'Skipped git hooks: run git init, then pnpm install again.'; fi",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm check:diagrams && pnpm test",
    "check:diagrams": "node scripts/check-diagrams.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^22.20.5",
    "jsdom": "^29.1.1",
    "lefthook": "^2.2.1",
    "mermaid": "^12.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
