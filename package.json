{
  "name": "ts-bumpers",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "node scripts/prepare.ts",
    "setup:tools": "node scripts/setup-tools.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p . && pnpm -r --parallel typecheck",
    "test": "vitest run",
    "check:diagrams": "node scripts/check-diagrams.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm check:diagrams && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.1",
    "mermaid": "^12.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
